# ---- LLM ----
# The graph currently hardcodes ChatOllama(model="llama3.1") in src/graph_nodes.py.
# LLM_MODEL / OPENAI_API_KEY are read by config.py but not yet wired to the LLM.
LLM_MODEL=llama3.1
OPENAI_API_KEY=

# ---- Embeddings ----
# "huggingface" (local, free) or "openai"
EMBEDDING_PROVIDER=huggingface
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Pinecone ----
PINECONE_API_KEY=
PINECONE_INDEX_NAME=agentic-rag-demo
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ---- Milvus / Zilliz Cloud ----
# Local Docker: http://localhost:19530 (leave MILVUS_TOKEN empty)
# Zilliz Cloud: your cluster endpoint + API key
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION_NAME=agentic_rag_demo

# ---- Agent behavior ----
RETRIEVAL_K=4
MAX_RETRIES=2
RELEVANCE_THRESHOLD=0.5
